# Pin pnpm virtual-store naming so every OS produces the same node_modules layout.
# pnpm defaults virtual-store-dir-max-length to 60 on Windows and 120 on
# Linux/macOS. @expo/fingerprint hashes the resulting .pnpm/... paths, so a
# Windows install and an EAS (Linux) install compute different runtime
# versions and EAS rejects the build ("Runtime version ... not equal").
# 60 matches the Windows default: shortest names, no MAX_PATH risk.
virtual-store-dir-max-length=60
