# Copy to .env for local development:  cp .env.example .env
# Never commit real values. EAS reads them from secrets / profile env in eas.json.

# API base URL, inlined into the JS bundle (all EXPO_PUBLIC_* vars are public).
EXPO_PUBLIC_API_URL=http://localhost:8080

# Realtime WS base URL. Empty derives from EXPO_PUBLIC_API_URL (http -> ws).
# EXPO_PUBLIC_WS_URL=ws://localhost:8080

# In-app mock backend (`true` = no network; feeds/auth served from fixtures).
# For E2E builds only — the `e2e-test` EAS profile sets this, never commit it on.
# EXPO_PUBLIC_API_MOCK=true

# Variant override for local Metro runs without eas.json.
# Defaults to "development" — app.config.ts reads APP_VARIANT (no EXPO_PUBLIC_ prefix).
# EXPO_PUBLIC_APP_VARIANT=development

# Public Sentry DSN. Empty means disabled ("would send" in __DEV__).
# Get it from Sentry Dashboard -> Project Settings -> Client Keys (DSN).
# EXPO_PUBLIC_SENTRY_DSN=https://example@sentry.io/0

# Only needed for your own EAS cloud builds. Skip for local runs.
# EXPO_OWNER=your-expo-username
# EAS_PROJECT_ID=your-project-id
